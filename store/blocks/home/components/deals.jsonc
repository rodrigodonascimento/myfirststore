{
  "flex-layout.row#deals": {
    "children": [
      "flex-layout.col#deals1",
      "flex-layout.col#deals2",
      "flex-layout.col#deals3",
      "flex-layout.col#deals4"
    ],
    "props": {
      "blockClass": "deals"
    }
  },
  "flex-layout.col#deals1": {
    "children": [
      "image#deals1",
      "rich-text#deals1"
    ]
  },
  "image#deals1": {
    "title": "Imagem Frete Grátis",
    "props": {
      "src": "https://storecomponents.vteximg.com.br/arquivos/box.png",
      "maxHeight": "24px"
    }
  },
  "rich-text#deals1": {
    "title": "Texto Frete Grátis",
    "props": {
      "text": "Frete grátis",
      "blockClass": "deals"
    }
  },
